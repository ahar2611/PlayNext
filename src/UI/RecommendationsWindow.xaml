<Window x:Class="PlayNext.UI.RecommendationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PlayNext.UI"
        Title="Play Next"
        Width="524" Height="812"
        MinWidth="420" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="#FFF4F5F7"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- ===== Palette ===== -->
        <Color x:Key="C.Base">#FF0D0F16</Color>
        <SolidColorBrush x:Key="B.Text" Color="#FFF4F5F7" />
        <SolidColorBrush x:Key="B.SubText" Color="#FFB4BAC8" />
        <SolidColorBrush x:Key="B.Faint" Color="#FF7C8396" />
        <SolidColorBrush x:Key="B.Glass" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="B.GlassStrong" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="B.GlassBorder" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="B.Track" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="B.Error" Color="#FFFB7185" />
        <!-- Accent brushes (B.Accent, B.AccentSoft, B.AccentLight, B.OnAccent, B.Glow) are created in code
             from the chosen color and referenced with DynamicResource so they can change and animate. -->
        <LinearGradientBrush x:Key="B.GlassEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33FFFFFF" Offset="0" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- ===== Text ===== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        </Style>
        <Style x:Key="T.Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource B.SubText}" />
        </Style>
        <Style x:Key="T.Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Faint}" />
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="Btn.Base" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="16" />
                            <Border x:Name="Hover" Background="#FFFFFFFF" CornerRadius="16" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Background" Value="{DynamicResource B.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Btn.Glass" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Background" Value="{StaticResource B.Glass}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.GlassBorder}" />
        </Style>
        <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn.Glass}">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Btn.SmallAccent" TargetType="Button" BasedOn="{StaticResource Btn.Accent}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource B.SubText}" />
        </Style>

        <!-- ===== Chip lists (categories, counts) ===== -->
        <Style x:Key="Chip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" Background="{StaticResource B.Glass}" BorderBrush="{StaticResource B.GlassBorder}"
                                    BorderThickness="1" CornerRadius="15" />
                            <Border x:Name="Sel" Background="{DynamicResource B.Accent}" CornerRadius="15" Opacity="0" />
                            <ContentPresenter x:Name="Text" Margin="13,6" TextElement.Foreground="{StaticResource B.SubText}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.GlassStrong}" />
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="Opacity" Value="1" />
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource B.OnAccent}" />
                                <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chip labels take the color the chip template sets (normal / hover / selected-on-accent).
             Needed because numbers (10/15/25) get a generated TextBlock that otherwise picks up the white text style. -->
        <DataTemplate x:Key="ChipLabel">
            <TextBlock Text="{Binding}"
                       Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                       FontWeight="{Binding (TextElement.FontWeight), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
        </DataTemplate>
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource ChipLabel}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Chip}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="ChipScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" CanContentScroll="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipWrap" TargetType="ListBox" BasedOn="{StaticResource ChipList}">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                        <Setter Property="Margin" Value="0,0,6,6" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ui:CollapsibleWrapPanel IsCollapsed="{Binding DataContext.ChipsCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Slim rounded scrollbar ===== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Background="#33FFFFFF" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Scroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SlimScrollBar}" Margin="6,2,0,2"
                                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Small info chip on cards ===== -->
        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Soft shadow, kept separate from the content so the effect doesn't re-render the whole UI -->
        <Border CornerRadius="24" Margin="2">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource C.Base}" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- Surface (clipped to rounded corners in code) -->
        <Grid x:Name="Surface">
            <!-- Backdrop: base gradient, blurred art of the #1 game, aurora glows, readability gradient -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                        <GradientStop Color="#FF151826" Offset="0" />
                        <GradientStop Color="#FF0D0F16" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image x:Name="Ambient" Source="{Binding AmbientImage}" Stretch="UniformToFill" Opacity="0.5" Margin="-90"
                   VerticalAlignment="Top" RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Ellipse Width="420" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-140,0,0" IsHitTestVisible="False" Fill="{DynamicResource B.Glow}" />
            <Ellipse Width="420" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-170,-150" IsHitTestVisible="False" Fill="{DynamicResource B.Glow}" Opacity="0.55" />
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#660D0F16" Offset="0" />
                        <GradientStop Color="#B30D0F16" Offset="0.35" />
                        <GradientStop Color="#E60D0F16" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Border CornerRadius="24" BorderThickness="1" BorderBrush="{StaticResource B.GlassEdge}" IsHitTestVisible="False" />

            <!-- Content -->
            <Grid Margin="18,14,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header (drag area) -->
                <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource B.Accent}">
                            <!-- Play Next logo (two lines + play), drawn so it takes the readable color on any accent -->
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="1" Canvas.Top="3.2" Width="14" Height="2.6" RadiusX="1.3" RadiusY="1.3" Fill="{DynamicResource B.OnAccent}" />
                                    <Rectangle Canvas.Left="1" Canvas.Top="8.6" Width="7" Height="2.6" RadiusX="1.3" RadiusY="1.3" Fill="{DynamicResource B.OnAccent}" />
                                    <Polygon Points="10.8,8.9 10.8,13.7 14.9,11.3" Fill="{DynamicResource B.OnAccent}" Stroke="{DynamicResource B.OnAccent}"
                                             StrokeThickness="1.7" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Play Next" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Picked from your own library" Foreground="{StaticResource B.Faint}" FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Icon}" Content="&#xE713;" ToolTip="Settings" Command="{Binding SettingsCommand}" />
                        <Button x:Name="MinimizeButton" Style="{StaticResource Btn.Icon}" Content="&#xE921;" FontSize="11" ToolTip="Minimize"
                                Click="MinimizeButton_Click" Margin="2,0,0,0" Visibility="Collapsed" />
                        <Button x:Name="CloseButton" Style="{StaticResource Btn.Icon}" Content="&#xE8BB;" FontSize="11" ToolTip="Close"
                                Click="CloseButton_Click" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Tabs + refresh -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource B.Glass}" BorderBrush="{StaticResource B.GlassBorder}" BorderThickness="1"
                            CornerRadius="18" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TabPill" Grid.Column="0" Grid.ColumnSpan="2" Width="118" HorizontalAlignment="Left" CornerRadius="15" Background="#2EFFFFFF">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TabPillShift" />
                                </Border.RenderTransform>
                            </Border>
                            <Button x:Name="ListTabButton" Grid.Column="0" Style="{StaticResource Btn.Base}" Padding="0,6" Command="{Binding ShowListCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,7,0" Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="For you" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Base}" Padding="0,6" Command="{Binding ShowPlaystyleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,7,0" Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="Your playstyle" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource B.Glass}" BorderBrush="{StaticResource B.GlassBorder}"
                            BorderThickness="1" CornerRadius="16" Padding="2" ToolTip="How many games" Visibility="{Binding ListVisibility}"
                            VerticalAlignment="Center">
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Counts}" SelectedItem="{Binding SelectedCount}"
                                 IsEnabled="{Binding CanInteract}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource Btn.Accent}" Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                            Command="{Binding RegenerateCommand}" IsEnabled="{Binding CanInteract}"
                            ToolTip="Refresh: make fresh lists for every category and update your playstyle (one AI request)">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.OnAccent}" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Category chips (list tab only). Collapsed: one row (the rest are clipped); expanded: all rows. -->
                <Grid Grid.Row="2" Margin="0,0,0,6" Visibility="{Binding ListVisibility}">
                    <ListBox x:Name="CategoryChips" Style="{StaticResource ChipWrap}" Margin="0,0,40,0"
                             ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding CanInteract}" />
                    <Button x:Name="ChipsToggle" Style="{StaticResource Btn.Icon}" Width="32" Height="31" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{StaticResource B.Glass}" BorderBrush="{StaticResource B.GlassBorder}" FontSize="10"
                            Content="{Binding ChipsToggleGlyph}" ToolTip="{Binding ChipsToggleTip}" Command="{Binding ToggleChipsCommand}" />
                </Grid>

                <!-- Main area -->
                <Grid Grid.Row="3">
                    <Grid x:Name="MainContent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="10" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- ===== For you ===== -->
                        <ScrollViewer x:Name="ListScroller" Style="{StaticResource Scroll}" Visibility="{Binding ListVisibility}">
                            <StackPanel>
                                <!-- Hero: #1 pick -->
                                <Grid x:Name="Hero" Visibility="{Binding FeaturedVisibility}" Margin="0,0,0,12" RenderTransformOrigin="0.5,0.5"
                                      MouseEnter="Hero_MouseEnter" MouseLeave="Hero_MouseLeave">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="HeroScale" />
                                    </Grid.RenderTransform>
                                    <Grid DataContext="{Binding Featured}">
                                        <Border CornerRadius="20">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF232733" Offset="0" />
                                                    <GradientStop Color="#FF13161E" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="20">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Background}" Stretch="UniformToFill" AlignmentY="Top" />
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="20">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#140D0F16" Offset="0" />
                                                    <GradientStop Color="#590D0F16" Offset="0.32" />
                                                    <GradientStop Color="#E00D0F16" Offset="0.62" />
                                                    <GradientStop Color="#F70D0F16" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource B.GlassEdge}" />

                                        <StackPanel Margin="16,14,16,16">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource B.Accent}" CornerRadius="10" Padding="9,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE735;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.OnAccent}" FontSize="10" Margin="0,0,5,0" />
                                                        <TextBlock Text="TOP PICK" Foreground="{DynamicResource B.OnAccent}" FontSize="10.5" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#E00D0F16" CornerRadius="10" Margin="6,0,0,0">
                                                    <Border Background="{Binding KindSoftBrush}" CornerRadius="10" Padding="9,3">
                                                        <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindBrush}" FontSize="10.5" FontWeight="Bold" />
                                                    </Border>
                                                </Border>
                                            </StackPanel>

                                            <Grid Margin="0,78,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="72" Height="96" VerticalAlignment="Bottom">
                                                    <Border CornerRadius="12" Background="#FF262A38" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                        <TextBlock Text="{Binding Initial}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource B.Faint}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}" />
                                                    </Border>
                                                    <Border CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="{Binding CoverVisibility}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Display}" FontSize="22" FontWeight="Bold"
                                                               TextWrapping="Wrap" LineHeight="26" />
                                                    <TextBlock Text="{Binding MetaLine}" Foreground="{StaticResource B.SubText}" FontSize="12" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="14" LineHeight="20" Margin="0,12,0,10"
                                                       Foreground="#FFE7E9F0" />

                                            <WrapPanel>
                                                <Border Style="{StaticResource InfoChip}" Visibility="{Binding LengthVisibility}" ToolTip="{Binding LengthTooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE916;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                        <TextBlock Text="Story " Foreground="{StaticResource B.Faint}" FontSize="12" />
                                                        <TextBlock Text="{Binding MainLength}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="   ·   100% " Foreground="{StaticResource B.Faint}" FontSize="12" />
                                                        <TextBlock Text="{Binding FullLength}" FontSize="12" FontWeight="SemiBold" />
                                                        <Border Background="#1AFFFFFF" CornerRadius="6" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LengthSource}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource B.SubText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChip}" Visibility="{Binding LookupVisibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE916;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                        <TextBlock Text="Checking HowLongToBeat…" FontSize="12" Foreground="{StaticResource B.Faint}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChip}" Visibility="{Binding EndlessVisibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE916;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                                        <TextBlock Text="No fixed ending" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChip}" Visibility="{Binding ScoreVisibility}" ToolTip="Critic / community score">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE735;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,5,0" Foreground="#FFFBBF24" />
                                                        <TextBlock Text="{Binding Score}" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChip}" Visibility="{Binding SourceVisibility}">
                                                    <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource B.SubText}" />
                                                </Border>
                                                <Border Style="{StaticResource InfoChip}" Visibility="{Binding InstalledVisibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="10" Margin="0,0,5,0" Foreground="#FF34D399" />
                                                        <TextBlock Text="Installed" FontSize="12" Foreground="{StaticResource B.SubText}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <StackPanel Visibility="{Binding ProgressVisibility}" Margin="0,4,0,4">
                                                <Grid Height="6">
                                                    <Border Background="{StaticResource B.Track}" CornerRadius="3" />
                                                    <Border Background="{Binding KindBrush}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource B.SubText}" FontSize="11.5" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PlayedLine}" Foreground="{StaticResource B.Faint}" FontSize="11.5" Margin="0,2,0,12" />

                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Btn.Accent}" Padding="18,8"
                                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.OnAccent}" FontSize="12" Margin="0,0,7,0" />
                                                        <TextBlock Text="Play" Foreground="{DynamicResource B.OnAccent}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Glass}" Margin="8,0,0,0" Content="Show in library"
                                                        Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" Content="&#xE711;" FontSize="11"
                                                        ToolTip="Not interested (hide from future picks)"
                                                        Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- #2 and below -->
                                <ItemsControl ItemsSource="{Binding Rest}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource B.GlassBorder}" Padding="12"
                                                    Margin="0,0,0,10" Opacity="0" RenderTransformOrigin="0.5,0.5"
                                                    Loaded="Card_Loaded" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#10FFFFFF" />
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Cover with rank badge -->
                                                    <Grid Width="62" Height="84" VerticalAlignment="Top" Margin="0,4,0,0">
                                                        <Border CornerRadius="11" Background="#FF262A38">
                                                            <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource B.Faint}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}" />
                                                        </Border>
                                                        <Border CornerRadius="11" Visibility="{Binding CoverVisibility}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <Border CornerRadius="11" BorderThickness="1" BorderBrush="#26FFFFFF" />
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" CornerRadius="10"
                                                                Background="#F01A1D29" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="7,2" MinWidth="26">
                                                            <TextBlock Text="{Binding Rank}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Background="{Binding KindSoftBrush}" CornerRadius="9" Padding="8,2"
                                                                    VerticalAlignment="Top" Margin="8,1,0,0">
                                                                <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindBrush}" FontSize="10.5" FontWeight="Bold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Display}" FontSize="15" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding MetaLine}" Foreground="{StaticResource B.Faint}" FontSize="11.5" Margin="0,1,0,6"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" LineHeight="18.5" Foreground="#FFDCDFE7" Margin="0,0,0,8" />

                                                        <WrapPanel>
                                                            <Border Style="{StaticResource InfoChip}" Visibility="{Binding LengthVisibility}"
                                                                    ToolTip="{Binding LengthTooltip}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE916;" Style="{StaticResource T.Icon}" FontSize="10" Margin="0,0,5,0" />
                                                                    <TextBlock Text="{Binding MainLength}" FontSize="11.5" FontWeight="SemiBold" />
                                                                    <TextBlock Text=" story · " Foreground="{StaticResource B.Faint}" FontSize="11.5" />
                                                                    <TextBlock Text="{Binding FullLength}" FontSize="11.5" FontWeight="SemiBold" />
                                                                    <TextBlock Text=" 100%" Foreground="{StaticResource B.Faint}" FontSize="11.5" />
                                                                    <Border Background="#1AFFFFFF" CornerRadius="6" Padding="4,0" Margin="7,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding LengthSource}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource B.SubText}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource InfoChip}" Visibility="{Binding LookupVisibility}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE916;" Style="{StaticResource T.Icon}" FontSize="10" Margin="0,0,5,0" />
                                                                    <TextBlock Text="Checking HowLongToBeat…" FontSize="11.5" Foreground="{StaticResource B.Faint}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource InfoChip}" Visibility="{Binding EndlessVisibility}">
                                                                <TextBlock Text="No fixed ending" FontSize="11.5" Foreground="{StaticResource B.SubText}" />
                                                            </Border>
                                                            <Border Style="{StaticResource InfoChip}" Visibility="{Binding ScoreVisibility}" ToolTip="Critic / community score">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE735;" Style="{StaticResource T.Icon}" FontSize="10" Margin="0,0,4,0" Foreground="#FFFBBF24" />
                                                                    <TextBlock Text="{Binding Score}" FontSize="11.5" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource InfoChip}" Visibility="{Binding InstalledVisibility}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="9" Margin="0,0,4,0" Foreground="#FF34D399" />
                                                                    <TextBlock Text="Installed" FontSize="11.5" Foreground="{StaticResource B.SubText}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </WrapPanel>

                                                        <StackPanel Visibility="{Binding ProgressVisibility}" Margin="0,0,0,6">
                                                            <Grid Height="5">
                                                                <Border Background="{StaticResource B.Track}" CornerRadius="2.5" />
                                                                <Border Background="{Binding KindBrush}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                                                    <Border.RenderTransform>
                                                                        <ScaleTransform ScaleX="{Binding Progress}" />
                                                                    </Border.RenderTransform>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource B.SubText}" FontSize="11" Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <DockPanel Tag="actions" Opacity="0.6" Margin="0,2,0,0">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Content="&#xE711;" FontSize="10"
                                                                    ToolTip="Not interested (hide from future picks)"
                                                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Style="{StaticResource Btn.SmallAccent}"
                                                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.OnAccent}" FontSize="10" Margin="0,0,6,0" />
                                                                        <TextBlock Text="Play" Foreground="{DynamicResource B.OnAccent}" FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Style="{StaticResource Btn.Small}" Margin="6,0,0,0" Content="Show in library"
                                                                        Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding PlayedLine}" Foreground="{StaticResource B.Faint}" FontSize="11" Margin="0,7,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ShortNote}" Visibility="{Binding ShortNoteVisibility}" Foreground="{StaticResource B.Faint}"
                                           FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10,4,10,10" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Your playstyle ===== -->
                        <ScrollViewer x:Name="PlaystyleScroller" Style="{StaticResource Scroll}" Visibility="{Binding PlaystyleVisibility}">
                            <StackPanel>
                                <Border CornerRadius="20" Padding="18" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource B.AccentSoft}"
                                        Visibility="{Binding ProfileVisibility}">
                                    <Border.Background>
                                        <SolidColorBrush Color="#12FFFFFF" />
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="YOUR PLAYSTYLE" Style="{StaticResource T.Caption}" Foreground="{DynamicResource B.AccentLight}" />
                                        <TextBlock Text="{Binding ProfileHeadline}" FontFamily="{StaticResource F.Display}" FontSize="27" FontWeight="Bold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource B.AccentLight}" Margin="0,4,0,8" LineHeight="32" />
                                        <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="#FFE2E5EC" />
                                        <ItemsControl ItemsSource="{Binding ProfileTraits}" Margin="0,14,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1AFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="14"
                                                            Padding="10,6" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE735;" Style="{StaticResource T.Icon}" FontSize="9" Foreground="{DynamicResource B.AccentLight}" Margin="0,2,7,0"
                                                                       VerticalAlignment="Top" />
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="380" FontSize="12.5" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="20" Padding="18" Margin="0,0,0,12" Background="{StaticResource B.Glass}"
                                        BorderThickness="1" BorderBrush="{StaticResource B.GlassBorder}" Visibility="{Binding NoProfileVisibility}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource T.Icon}" FontSize="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Your playstyle summary shows up here after the next Refresh." TextWrapping="Wrap" MaxWidth="360"
                                                   Foreground="{StaticResource B.SubText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Genre mix -->
                                <Border CornerRadius="20" Padding="16" Margin="0,0,0,12" Background="{StaticResource B.Glass}"
                                        BorderThickness="1" BorderBrush="{StaticResource B.GlassBorder}" Visibility="{Binding GenreMixVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="WHERE YOUR HOURS GO" Style="{StaticResource T.Caption}" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding GenreMix}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <DockPanel Margin="0,0,0,5">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding HoursText}" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                                        </DockPanel>
                                                        <Grid Height="7" ToolTip="{Binding Percent}">
                                                            <Border Background="{StaticResource B.Track}" CornerRadius="3.5" />
                                                            <Border Background="{DynamicResource B.Accent}" CornerRadius="3.5" RenderTransformOrigin="0,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding Share}" />
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- By the numbers -->
                                <TextBlock Text="BY THE NUMBERS" Style="{StaticResource T.Caption}" Margin="4,4,0,10" />
                                <ItemsControl ItemsSource="{Binding Stats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="18" Padding="14,12" Margin="0,0,10,10" Background="{StaticResource B.Glass}"
                                                    BorderThickness="1" BorderBrush="{StaticResource B.GlassBorder}">
                                                <StackPanel>
                                                    <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource B.AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{DynamicResource B.AccentLight}"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource B.SubText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Empty -->
                    <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <Border Width="64" Height="64" CornerRadius="22" Background="{DynamicResource B.Accent}" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.OnAccent}" FontSize="24" HorizontalAlignment="Center" Margin="3,0,0,0" />
                        </Border>
                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource B.SubText}" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,16" FontSize="14" />
                        <Button Style="{StaticResource Btn.Accent}" Padding="18,9" Content="Make my lists" Command="{Binding RegenerateCommand}"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Error -->
                    <Border Visibility="{Binding ErrorVisibility}" CornerRadius="20" Padding="18" VerticalAlignment="Center" Margin="6"
                            BorderThickness="1" BorderBrush="#40FB7185">
                        <Border.Background>
                            <SolidColorBrush Color="#E6181B26" />
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="34" Height="34" CornerRadius="12" Background="#26FB7185">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Error}" FontSize="15" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Couldn't make your lists" FontFamily="{StaticResource F.Display}" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="11,0,0,0" />
                            </StackPanel>
                            <ScrollViewer Style="{StaticResource Scroll}" MaxHeight="260">
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource B.SubText}" LineHeight="19" />
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Btn.Accent}" Content="Try again" Command="{Binding RegenerateCommand}" />
                                <Button Style="{StaticResource Btn.Glass}" Content="Open settings" Command="{Binding SettingsCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Busy -->
                    <Grid x:Name="BusyOverlay" Visibility="{Binding BusyVisibility}" IsVisibleChanged="BusyOverlay_IsVisibleChanged">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <Grid Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Ellipse Stroke="#1FFFFFFF" StrokeThickness="5" />
                                <Ellipse StrokeThickness="5" StrokeDashCap="Round" StrokeDashArray="9 30" RenderTransformOrigin="0.5,0.5"
                                         Stroke="{DynamicResource B.Accent}">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" />
                                    </Ellipse.RenderTransform>

                                </Ellipse>
                                <TextBlock x:Name="SpinnerGlyph" Text="&#xE768;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Text}" FontSize="20"
                                           HorizontalAlignment="Center" Margin="3,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding BusyText}" FontFamily="{StaticResource F.Display}" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{Binding BusyDetail}" Foreground="{StaticResource B.SubText}" TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="340" Margin="0,8,0,0" LineHeight="19" />
                            <Button Style="{StaticResource Btn.Glass}" Content="Cancel" Command="{Binding CancelCommand}"
                                    HorizontalAlignment="Center" Margin="0,18,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <TextBlock Grid.Row="4" Text="{Binding Footer}" Foreground="{StaticResource B.Faint}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="4,10,4,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
